# Caddy config for the agentique VPS. Install target: /etc/caddy/Caddyfile
# Caddy handles TLS (Let's Encrypt) automatically for every site block.

agentique.ch {
	root * /opt/agentique/frontend/dist
	encode zstd gzip

	# Prerendered blog pages: unknown slugs must get a real 404, not the SPA
	# shell (a 200 "soft 404" that search engines treat as thin content).
	@blog path /blog /blog/*
	handle @blog {
		try_files {path} {path}/
		file_server
	}

	# The MCP endpoint is the backend, not the SPA. Served from the site host
	# rather than api. so an agent is configured with one origin, the same
	# path the Vite proxy serves in dev. Auth is the bearer token the app
	# checks — Caddy just forwards.
	handle /mcp* {
		reverse_proxy 127.0.0.1:8000
	}

	# Static data files the pipeline writes on the box (the topic map). They
	# live outside frontend/dist because the deploy's rsync --delete replaces
	# that folder wholesale.
	handle_path /data/* {
		root * /srv/agentique/public
		header Cache-Control "public, max-age=900"
		file_server
	}

	# SPA fallback for everything else.
	handle {
		try_files {path} /index.html
		file_server
	}
}

www.agentique.ch {
	redir https://agentique.ch{uri} permanent
}

api.agentique.ch {
	reverse_proxy 127.0.0.1:8000
}
