# Install target: /etc/systemd/system/agentique-pipeline.service
# Runs once per activation (see agentique-pipeline.timer for the schedule).
# Manual run: sudo systemctl start agentique-pipeline
[Unit]
Description=agentique article pipeline (one run)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=agentique
Group=agentique
WorkingDirectory=/opt/agentique/backend
# pipeline/run.py reads raw os.environ and loads no dotenv — EnvironmentFile
# is what feeds it.
EnvironmentFile=/opt/agentique/.env
# agentique is a system user (adduser --system) with home=/nonexistent.
# Anything that embeds via model2vec lazy-downloads through huggingface_hub and
# expands ~ for its cache dir — fails with EACCES against /nonexistent. /var/lib/agentique is real and writable (vps-setup.sh) and
# lives outside /opt/agentique so the deploy rsync's --delete never touches it.
Environment=HOME=/var/lib/agentique
ExecStart=/opt/agentique/.venv/bin/python -m pipeline.run
