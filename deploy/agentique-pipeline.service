# Install target: /etc/systemd/system/agentique-pipeline.service
# Runs once per activation (see agentique-pipeline.timer for the schedule).
# Manual run: sudo systemctl start agentique-pipeline
[Unit]
Description=agentique article pipeline (one run)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=agentique
Group=agentique
WorkingDirectory=/opt/agentique/backend
# pipeline/run.py and pipeline/health.py read raw os.environ and load no
# dotenv — EnvironmentFile is what feeds them.
EnvironmentFile=/opt/agentique/.env
ExecStart=/opt/agentique/.venv/bin/python -m pipeline.run
