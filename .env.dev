# Throwaway credentials for a LOCAL/sandbox Postgres restored from dumps/.
# Committed on purpose so cloud sessions can bring the db up with no setup.
# Never put prod values here — prod lives in /opt/agentique/.env on the server.
# scripts/restore-db.sh copies this to .env when .env is missing.

PROJECT_NAME=agentique
ENVIRONMENT=development
SECRET_KEY=dev-secret-key-not-for-deployment
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173

# POSTGRES_USER must stay `postgres`: the dumps carry `OWNER TO postgres`.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=agentique-dev
POSTGRES_DB=app

FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=agentique-dev

# MCP server. The db user is `postgres` locally because `agentique_ro` only
# exists on the prod box (deploy/sql-roles.sql); the read-only transaction the
# tool opens still applies.
MCP_TOKEN=agentique-dev
# The curation agent's token: the one that may publish and reject.
MCP_WRITE_TOKEN=agentique-dev-write
MCP_DB_USER=postgres
MCP_DB_PASSWORD=agentique-dev
